# Скопируйте этот файл в .env и заполните. .env не попадает в git.

APP_ENV=dev

# По умолчанию — SQLite-файл backend/jobready.db, ничего ставить не нужно.
# Для Postgres из docker-compose.yml:
# DATABASE_URL=postgresql+asyncpg://jobready:jobready@localhost:5432/jobready

# Адреса фронтенда (JSON-список).
CORS_ORIGINS=["http://localhost:3000"]

LLM_PROVIDER=gigachat

# Ключ авторизации из личного кабинета Сбера (Настройка API → Authorization key).
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Чат-модели: GigaChat-2, GigaChat-2-Pro, GigaChat-2-Max, GigaChat-3-Lightning, GigaChat-3-Pro, GigaChat-3-Ultra
# (актуальный список: http://localhost:8000/health/llm)
GIGACHAT_MODEL=GigaChat-2
# GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1

# Корневой сертификат Минцифры — см. README, раздел «Сертификат GigaChat».
# Путь относительно папки backend.
# GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.cer
GIGACHAT_VERIFY_SSL=true

# Секрет для подписи кодов из SMS. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Куда отправлять SMS: console — код печатается в консоль сервера (для разработки).
SMS_PROVIDER=console
